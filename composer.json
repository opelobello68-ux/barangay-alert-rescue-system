{
  "name": "bars/barangay-alert-rescue-system",
  "type": "project",
  "description": "Barangay Alert and Rescue System - Laravel mini-capstone prototype",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0 || ^12.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
